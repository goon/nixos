#!/usr/bin/env bash
# Quickshell Debugger
# Restarts Quickshell with Advanced Debugging.

APP="quickshell"

notify() {
    if command -v notify-send >/dev/null; then
        notify-send "Quickshell Debug" "$1" \
            --app-name="Quickshell" \
            --icon="utilities-terminal" \
            --urgency=low
    fi
}

echo "Stopping Quickshell..."
pkill "$APP"

COUNT=0
while pgrep "$APP" >/dev/null && [ $COUNT -lt 20 ]; do
    sleep 0.1
    ((COUNT++))
done

if pgrep "$APP" >/dev/null; then
    pkill -9 "$APP"
fi

notify "Starting debug mode..."
echo "Starting Quickshell in foreground..."
echo "-----------------------------------"

"$APP"
