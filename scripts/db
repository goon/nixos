#!/usr/bin/env bash
set -e

RE='\033[0;31m'
GR='\033[0;32m'
YE='\033[0;33m'
BL='\033[0;34m'
NC='\033[0m'

info() { echo -e "${BL}[INFO]${NC} $1"; }
success() { echo -e "${GR}[SUCCESS]${NC} $1"; }
warn() { echo -e "${YE}[WARN]${NC} $1"; }
error() { echo -e "${RE}[ERROR]${NC} $1"; exit 1; }

command -v gum &>/dev/null || error "gum is required but not installed."

COG=$'\uF013'
FLASK=$'\uF0C3'
ARROWS=$'\uF021'
TRASH=$'\uF1F8'
LIST=$'\uF0CB'
LINE='│'

choice=$(gum choose \
    --cursor " ❯" \
    "${LINE} ${COG}  Rebuild" \
    "${LINE} ${FLASK}  Test" \
    "${LINE} ${ARROWS}  Update" \
    "${LINE} ${TRASH}  Collect Garbage" \
    "${LINE} ${LIST}  List Generations")

case "$choice" in
    *Rebuild)
        info "Rebuilding system..."
        nh os switch
        success "Rebuild complete!"
        ;;
    *Test)
        info "Testing configuration..."
        nh os test
        success "Test complete!"
        ;;
    *Update)
        info "Updating flake inputs and rebuilding..."
        nh os switch -u
        success "Update complete!"
        ;;
    *"Collect Garbage")
        info "Collecting garbage..."
        nh clean all --keep 8
        success "Garbage collection complete!"
        ;;
    *"List Generations")
        sudo nix-env --list-generations --profile /nix/var/nix/profiles/system | head -50
        ;;
    *)
        warn "No option selected."
        ;;
esac
