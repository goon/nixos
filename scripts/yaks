#!/usr/bin/env bash
set -euo pipefail

cmd="${1:-}"; shift 2>/dev/null || true

notify() {
  if command -v notify-send >/dev/null; then
    notify-send "Quickshell" "$1" \
      --app-name="Quickshell" \
      --icon="system-software-update" \
      --urgency=low
  fi
}

cmd_reload() {
  if systemctl --user is-active --quiet quickshell.service; then
    echo "Reloading Quickshell QML engine..."
    if qs ipc call shell reload true; then
      notify "Shell reloaded successfully"
      echo "Done."
    else
      notify "IPC reload failed"
      echo "Error: IPC reload failed. Run 'systemctl --user restart quickshell.service' to force a service restart."
      exit 1
    fi
  else
    echo "Quickshell is not running. Starting it..."
    if systemctl --user start quickshell.service; then
      notify "Shell started"
      echo "Done."
    else
      notify "Failed to start quickshell"
      echo "Error: Failed to start quickshell.service"
      exit 1
    fi
  fi
}

cmd_log() {
  stdbuf -oL journalctl --user -u quickshell -f | awk '{
    gsub(/WARN|warn/, "\033[33m&\033[0m")
    gsub(/ERROR|error|FATAL|fatal/, "\033[31m&\033[0m")
    print
  }'
}

cmd_status() {
  systemctl --user status quickshell -n 0 --no-pager
}

usage() {
  cat <<EOF
yaks — quickshell management

Usage: yaks <command>

Commands:
  reload   Reload or start Quickshell (IPC reload if running, start if not)
  log      Tail the quickshell journal
  status   Show service status
EOF
}

case "$cmd" in
  reload)              cmd_reload ;;
  log)                 cmd_log ;;
  status)              cmd_status ;;
  -h|--help|"")        usage ;;
  *)                   echo "Unknown command: $cmd"; usage; exit 1 ;;
esac
