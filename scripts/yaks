#!/usr/bin/env bash
set -euo pipefail

# --- Colors ---
RE='\033[0;31m'
GR='\033[0;32m'
YE='\033[0;33m'
BL='\033[0;34m'
NC='\033[0m'

info() { echo -e "${BL}[INFO]${NC} $1"; }
success() { echo -e "${GR}[SUCCESS]${NC} $1"; }
warn() { echo -e "${YE}[WARN]${NC} $1"; }
error() { echo -e "${RE}[ERROR]${NC} $1"; exit 1; }

cmd="${1:-}"; shift 2>/dev/null || true

notify() {
  if command -v notify-send >/dev/null; then
    notify-send "Yaks" "$1" \
      --app-name="Yaks" \
      --icon="system-software-update" \
      --urgency=low
  fi
}

cmd_reload() {
  if systemctl --user is-active --quiet yaks.service; then
    info "Reloading Yaks QML engine..."
    if qs ipc call shell reload true; then
      notify "Shell reloaded successfully"
      success "Done."
    else
      notify "IPC reload failed"
      error "IPC reload failed. Run '${YE}systemctl --user restart yaks.service${NC}' to force a service restart."
    fi
  else
    info "Yaks is not running. Starting it..."
    if systemctl --user start yaks.service; then
      notify "Shell started"
      success "Done."
    else
      notify "Failed to start yaks"
      error "Failed to start yaks.service"
    fi
  fi
}

cmd_log() {
  stdbuf -oL journalctl --user -u yaks -f | awk '{
    gsub(/WARN|warn/, "\033[33m&\033[0m")
    gsub(/ERROR|error|FATAL|fatal/, "\033[31m&\033[0m")
    print
  }'
}

cmd_status() {
  systemctl --user status yaks -n 0 --no-pager
}

usage() {
  echo -e "${BL}yaks${NC} — yaks management"
  echo ""
  echo -e "Usage: ${GR}yaks${NC} ${YE}<command>${NC}"
  echo ""
  echo "Commands:"
  echo -e "  ${GR}reload${NC}   Reload or start Quickshell (IPC reload if running, start if not)"
  echo -e "  ${GR}log${NC}      Tail the quickshell journal"
  echo -e "  ${GR}status${NC}   Show service status"
}

case "$cmd" in
  reload)              cmd_reload ;;
  log)                 cmd_log ;;
  status)              cmd_status ;;
  -h|--help|"")        usage ;;
  *)                   usage; echo ""; error "Unknown command: ${YE}$cmd${NC}" ;;
esac
