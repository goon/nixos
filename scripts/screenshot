#!/usr/bin/env bash

DIR="${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots"
mkdir -p "$DIR"

FILE="$DIR/$(date +%Y%m%d_%H%M%S).png"

MODE="${1:-area}"

case "$MODE" in
    full)
        grim "$FILE"
        ;;
    area|*)
        GEOM=$(slurp)
        if [ -n "$GEOM" ]; then
            grim -g "$GEOM" "$FILE"
        fi
        ;;
esac

if [ -f "$FILE" ]; then
    wl-copy < "$FILE"
    notify-send "Screenshot Captured" "Saved to $(basename "$FILE") and copied to clipboard." -i "$FILE" --app-name="grim"
fi
