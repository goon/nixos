#!/usr/bin/env bash

set -euo pipefail

MODE="${1:?usage: recording <screen|region>}"

DIR="$HOME/Videos"
mkdir -p "$DIR"
FILE="$DIR/$(date +%Y%m%d_%H%M%S).mp4"

stop() {
  local mode="$1"
  local pid saved_file=""
  pid=$(pgrep -f "gpu-screen-recorder -w $mode" | head -1)
  if [ -n "$pid" ] && [ -r "/proc/$pid/cmdline" ]; then
    saved_file=$(tr '\0' ' ' < "/proc/$pid/cmdline" | sed -n 's/.*-o \([^ ]*\).*/\1/p')
  fi
  pkill -SIGINT -f "gpu-screen-recorder -w $mode"
  while pgrep -f "gpu-screen-recorder -w $mode" >/dev/null 2>&1; do sleep 0.1; done
  if [ -n "$saved_file" ] && [ -f "$saved_file" ]; then
    setsid notify-send -a "Quickshell" -i "screen_record" \
      "Recording" "Stopped recording and saved to $(basename "$saved_file")" < /dev/null > /dev/null 2>&1 &
  else
    setsid notify-send -a "Quickshell" -i "screen_record" \
      "Recording" "Stopped recording." < /dev/null > /dev/null 2>&1 &
  fi
}

start_screen() {
  setsid gpu-screen-recorder -w screen -q ultra -f 144 -a default_output -o "$FILE" \
    < /dev/null > /dev/null 2>&1 &
  setsid notify-send -a "Quickshell" -i "screen_record" \
    "Recording" "Started recording screen." < /dev/null > /dev/null 2>&1 &
}

start_region() {
  GEOM=$(slurp -f "%wx%h+%x+%y") || exit 0
  setsid gpu-screen-recorder -w region -region "$GEOM" -q ultra -f 144 -a default_output -o "$FILE" \
    < /dev/null > /dev/null 2>&1 &
  setsid notify-send -a "Quickshell" -i "screen_record" \
    "Recording" "Started recording region." < /dev/null > /dev/null 2>&1 &
}

case "$MODE" in
  screen)
    if pgrep -f "gpu-screen-recorder -w screen" >/dev/null; then
      stop screen
    else
      start_screen
    fi
    ;;
  region)
    if pgrep -f "gpu-screen-recorder -w region" >/dev/null; then
      stop region
    else
      start_region
    fi
    ;;
  *)
    echo "usage: recording <screen|region>" >&2
    exit 1
    ;;
esac
