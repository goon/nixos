#!/usr/bin/env bash

# NixOS Automated Bootstrap Script
# This script automates the hardware configuration and build process for a fresh install.
# Usage:
#   1. Boot into a fresh NixOS installation.
#   2. Clone this repository: nix-shell -p git --run "git clone --recursive https://github.com/goon/nixos ~/.nixos"
#   3. Run this script: cd ~/.nixos && ./scripts/bootstrap

set -e

# --- Configuration & Colors ---
RE='\033[0;31m'
GR='\033[0;32m'
YE='\033[0;33m'
BL='\033[0;34m'
NC='\033[0m'

info() { echo -e "${BL}[INFO]${NC} $1"; }
success() { echo -e "${GR}[SUCCESS]${NC} $1"; }
warn() { echo -e "${YE}[WARN]${NC} $1"; }
error() { echo -e "${RE}[ERROR]${NC} $1"; exit 1; }

if [ ! -f "/etc/NIXOS" ]; then
    error "This script must be run on NixOS."
fi

if [ ! -f "flake.nix" ] || [ ! -d "modules" ]; then
    error "This script must be run from the root of the NixOS configuration directory (cd ~/.nixos)."
fi

# Ask for the administrator password upfront
info "Asking for sudo password upfront..."
sudo -v

# Keep-alive: update existing sudo time stamp until the script has finished
while true; do sudo -n true; sleep 60; kill -0 "$$" || exit; done 2>/dev/null &

# Ensure submodules are up to date in case the user forgot --recursive during clone
info "Checking submodules..."
nix-shell -p git --run "git submodule update --init --recursive"


info "We are about to install the 'desktop' host."
echo -e -n "${YE}Press enter to continue or Ctrl+C to abort...${NC} "
read -r

# 4. Generate Hardware Configuration
info "Generating hardware configuration for 'desktop'..."
mkdir -p hosts/desktop
nixos-generate-config --show-hardware-config > hosts/desktop/hardware-configuration.nix
success "Hardware configuration saved to hosts/desktop/hardware-configuration.nix"

# 5. Rebuild and Switch
info "Starting NixOS rebuild... this may take a while."
sudo nixos-rebuild switch --flake .#desktop

# 6. Update Flake Inputs
info "Updating flake inputs..."
sudo nix flake update
success "Flake inputs updated."

success "Bootstrap complete! Your system is now running the new configuration."
