#!/usr/bin/env bash

# NixOS Automated Bootstrap Script
# This script automates the hardware configuration and build process for a fresh install.
# Usage:
#   1. Boot into a fresh NixOS installation.
#   2. Clone this repository: nix-shell -p git --run "git clone --recursive https://github.com/goon/nixos ~/.nixos"
#   3. Run this script: cd ~/.nixos && ./scripts/bootstrap

set -euo pipefail

# --- Configuration & Colors ---

RE='\033[0;31m'
GR='\033[0;32m'
YE='\033[0;33m'
BL='\033[0;34m'
NC='\033[0m'

info() { echo -e "${BL}[INFO]${NC} $1"; }
success() { echo -e "${GR}[SUCCESS]${NC} $1"; }
warn() { echo -e "${YE}[WARN]${NC} $1"; }
error() { echo -e "${RE}[ERROR]${NC} $1"; exit 1; }

if [ ! -f "/etc/NIXOS" ]; then
    error "/etc/nixos not found."
fi

if [ ! -f "flake.nix" ] || [ ! -d "modules" ]; then
    error "The bootstrapping process must be started from the root of the NixOS configuration."
fi

FORCE=""
case "${1:-}" in
    "") ;;
    --force) FORCE=1 ;;
    *) error "Usage: bootstrap [--force]" ;;
esac

shopt -s nullglob
GENERATIONS=(/nix/var/nix/profiles/system-*-link)
if [ "${#GENERATIONS[@]}" -gt 2 ] && [ "$FORCE" != "1" ]; then
    error "Multiple ${#GENERATIONS[@]} found, suggesting a non fresh install. Run with --force to override."
fi

info "Requesting sudo password."
sudo -v

while true; do sudo -n true; sleep 60; kill -0 "$$" || exit; done 2>/dev/null &

info "Checking submodules..."
nix-shell -p git --run "git submodule update --init --recursive"

HOSTS=()
for dir in hosts/*/; do
    if [ -d "$dir" ]; then
        HOSTS+=("$(basename "$dir")")
    fi
done

if [ ${#HOSTS[@]} -eq 0 ]; then
    error "No hosts found within configuration."
fi

info "Available Hosts:"
SELECTED_HOST=""
select SELECTED_HOST in "${HOSTS[@]}"; do
    [ -n "$SELECTED_HOST" ] && break
    error "Invalid selection."
done
[ -n "$SELECTED_HOST" ] || error "No host selected."

info "Beginning installation for the '$SELECTED_HOST' host."
echo -e -n "${YE}Press enter to continue or Ctrl+C to abort...${NC} "
read -r

info "Generating hardware configuration for '$SELECTED_HOST'..."
mkdir -p "hosts/$SELECTED_HOST"
nixos-generate-config --show-hardware-config > "hosts/$SELECTED_HOST/hardware-configuration.nix"
success "Hardware configuration saved to hosts/$SELECTED_HOST/hardware-configuration.nix"

info "Rebuild initiated... this may take a while."
sudo nixos-rebuild switch --flake ".#$SELECTED_HOST"

success "Bootstrapping complete! Your system is now running the new configuration."
