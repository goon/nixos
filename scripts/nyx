#!/usr/bin/env bash
set -euo pipefail

NYX_DIR="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"
export NYX_DIR

# --- Paths & Globals ---
if [ -f "$NYX_DIR/../nyx.repo" ]; then
  REPO="$(cat "$NYX_DIR/../nyx.repo")"
else
  _dir="$NYX_DIR"
  while [ ! -f "$_dir/flake.nix" ]; do
    _dir="$(dirname "$_dir")"
    [ "$_dir" = "/" ] && { echo -e "\033[0;31m[ERROR]\033[0m Could not find flake.nix from $NYX_DIR"; exit 1; }
  done
  REPO="$_dir"
fi

MODULES_DIR="$REPO/modules"
HOSTS_DIR="$REPO/hosts"
SCRIPTS_DIR="$REPO/scripts"
FLAKE_NIX="$REPO/flake.nix"

export REPO MODULES_DIR HOSTS_DIR SCRIPTS_DIR FLAKE_NIX
cd "$REPO"

# --- Colors & Logging ---
RE='\033[0;31m'
GR='\033[0;32m'
YE='\033[0;33m'
BL='\033[0;34m'
NC='\033[0m'

info() { echo -e "${BL}[INFO]${NC} $1"; }
success() { echo -e "${GR}[SUCCESS]${NC} $1"; }
warn() { echo -e "${YE}[WARN]${NC} $1"; }
error() { echo -e "${RE}[ERROR]${NC} $1"; exit 1; }

# --- Library Functions ---
discover_modules() {
  local modules_dir="$MODULES_DIR"
  for category_dir in "$modules_dir"/*/; do
    [ -d "$category_dir" ] || continue
    category="$(basename "$category_dir")"
    case "$category" in _*) continue ;; .*) continue ;; globals) continue ;; esac
    for entry in "$category_dir"*; do
      [ -e "$entry" ] || continue
      name="$(basename "$entry")"
      case "$name" in _*) continue ;; .*) continue ;; esac
      if [ -d "$entry" ]; then
        [ -f "$entry/default.nix" ] || continue
        [ -f "$entry/.git" ] && continue
        echo "$category $name"
      elif [ -f "$entry" ] && [[ "$name" == *.nix ]] && [ "$name" != "default.nix" ]; then
        echo "$category ${name%.nix}"
      fi
    done
  done
}

discover_modules_raw() {
  discover_modules | sort -k1,1 -k2,2
}

discover_hosts() {
  for dir in "$HOSTS_DIR"/*/; do
    [ -d "$dir" ] || continue
    name="$(basename "$dir")"
    case "$name" in _*) continue ;; .*) continue ;; esac
    [ -f "$dir/default.nix" ] || continue
    echo "$name"
  done
}

host_dashboard_path() {
  local host="$1"
  echo "$HOSTS_DIR/$host/default.nix"
}

host_dashboard_exists() {
  local host="$1"
  [ -f "$HOSTS_DIR/$host/default.nix" ]
}

host_dashboard_enabled() {
  local host="$1"
  local dashboard="$HOSTS_DIR/$host/default.nix"
  if [ -f "$dashboard" ]; then
    grep -E '^[[:space:]]*module\.[a-zA-Z0-9_-]+\.enable[[:space:]]*=[[:space:]]*(true|false);' "$dashboard" | \
      sed -E 's/.*module\.([a-zA-Z0-9_-]+)\.enable.*=.*(true|false).*/\1 \2/'
  fi
}

get_host() {
  local requested_host="${1:-}"
  local host=""
  if [ -z "$requested_host" ]; then
    host="$(hostname -s 2>/dev/null || true)"
    if [ -z "$host" ] || ! host_dashboard_exists "$host"; then
      local hosts_list="$(discover_hosts | awk '{printf "%s%s", sep, $0; sep=", "} END{print ""}')"
      error "Could not determine hostname or host has no dashboard. Available hosts: $hosts_list"
    fi
  else
    if ! host_dashboard_exists "$requested_host"; then
      local hosts_list="$(discover_hosts | awk '{printf "%s%s", sep, $0; sep=", "} END{print ""}')"
      error "Host '$requested_host' not found. Available hosts: $hosts_list"
    fi
    host="$requested_host"
  fi
  echo "$host"
}

print_category_group() {
  local category="$1"
  local always="$2"
  local on="$3"
  local off="$4"

  always="${always%, }"
  on="${on%, }"
  off="${off%, }"

  case "$category" in
    core|shared)
      echo "  $category (always on):"
      echo "    $always"
      echo ""
      ;;
    *)
      echo "  $category:"
      if [ -n "$on" ]; then
        echo -e "    ${GR}[on]${NC}  $on"
      fi
      if [ -n "$off" ]; then
        echo -e "    ${YE}[off]${NC} $off"
      fi
      echo ""
      ;;
  esac
}

# --- Module Commands ---
cmd_module_list() {
  local host="$(get_host "${1:-}")"
  echo ""
  info "Modules on $host"
  echo ""

  local enabled_list
  enabled_list="$(host_dashboard_enabled "$host")"

  local current_category=""
  local on_names=""
  local off_names=""
  local always_names=""

  while IFS=' ' read -r category name; do
    if [ "$category" != "$current_category" ]; then
      if [ -n "$current_category" ]; then
        print_category_group "$current_category" "$always_names" "$on_names" "$off_names"
      fi
      current_category="$category"
      on_names=""
      off_names=""
      always_names=""
    fi

    case "$category" in
      core|shared)
        always_names="${always_names}${name}, "
        ;;
      *)
        if echo "$enabled_list" | grep -q "^$name true$"; then
          on_names="${on_names}${name}, "
        else
          off_names="${off_names}${name}, "
        fi
        ;;
    esac
  done < <(discover_modules_raw)

  if [ -n "$current_category" ]; then
    print_category_group "$current_category" "$always_names" "$on_names" "$off_names"
  fi
}

cmd_module_enable() {
  local module_name="${1:-}"
  if [ -z "$module_name" ]; then
    error "Please specify a module to enable. Usage: nyx module enable <name> [host]"
  fi
  local host="$(get_host "${2:-}")"
  local dashboard="$HOSTS_DIR/$host/default.nix"
  
  # Check if module exists
  local module_exists=false
  while IFS=' ' read -r category name; do
    if [ "$name" = "$module_name" ]; then
      module_exists=true
      break
    fi
  done < <(discover_modules_raw)
  
  if ! $module_exists; then
    error "Module '$module_name' does not exist."
  fi
  
  if grep -qE "^[[:space:]]*module\.$module_name\.enable[[:space:]]*=" "$dashboard"; then
    sed -i -E "s/^[[:space:]]*module\.$module_name\.enable[[:space:]]*=.*$/  module.$module_name.enable = true;/" "$dashboard"
  else
    # Insert before the last closing brace
    sed -i -E "/^}/i \ \ module.$module_name.enable = true;" "$dashboard"
  fi
  
  success "Enabled module '$module_name' on host '$host'."
}

cmd_module_disable() {
  local module_name="${1:-}"
  if [ -z "$module_name" ]; then
    error "Please specify a module to disable. Usage: nyx module disable <name> [host]"
  fi
  local host="$(get_host "${2:-}")"
  local dashboard="$HOSTS_DIR/$host/default.nix"
  
  if grep -qE "^[[:space:]]*module\.$module_name\.enable[[:space:]]*=" "$dashboard"; then
    sed -i -E "s/^[[:space:]]*module\.$module_name\.enable[[:space:]]*=.*$/  module.$module_name.enable = false;/" "$dashboard"
    success "Disabled module '$module_name' on host '$host'."
  else
    success "Module '$module_name' was not enabled on host '$host'."
  fi
}

cmd_module() {
  local verb="${1:-list}"
  shift 2>/dev/null || true
  case "$verb" in
    list) cmd_module_list "$@" ;;
    enable) cmd_module_enable "$@" ;;
    disable) cmd_module_disable "$@" ;;
    *) error "Unknown module subcommand: $verb. Valid: list, enable, disable" ;;
  esac
}

cmd_help() {
  echo -e "Usage: ${GR}nyx${NC} ${YE}[subcommand]${NC}"
  echo ""
  echo "Available subcommands:"
  echo -e "  ${GR}help${NC}                          Show this help"
  echo -e "  ${GR}build${NC}                         nh os build"
  echo -e "  ${GR}switch${NC}                        nh os switch"
  echo -e "  ${GR}boot${NC}                          nh os boot"
  echo -e "  ${GR}test${NC}                          nh os test"
  echo -e "  ${GR}update${NC}                        nh os switch -u"
  echo -e "  ${GR}clean${NC}                         nh clean all --keep 8"
  echo -e "  ${GR}fmt${NC}                           nix fmt"
  echo -e "  ${GR}search${NC} ${YE}<pkg>${NC}                  nix search nixpkgs <pkg>"
  echo -e "  ${GR}run${NC} ${YE}<pkg>${NC}                     nix run nixpkgs#<pkg>"
  echo -e "  ${GR}shell${NC} ${YE}<pkg>${NC}                   nix shell nixpkgs#<pkg>"
  echo -e "  ${GR}generations${NC}                   List system generations"
  echo -e "  ${GR}module list${NC} ${YE}[host]${NC}            List modules enabled/disabled on a host"
  echo -e "  ${GR}module enable${NC} ${YE}<name> [host]${NC}   Enable a module on a host"
  echo -e "  ${GR}module disable${NC} ${YE}<name> [host]${NC}  Disable a module on a host"
}

# --- Router ---
cmd="${1:-help}"; shift || true
case "$cmd" in
  build|boot|switch|test) exec nh os "$cmd" "$@" ;;
  update) exec nh os switch -u "$@" ;;
  clean)
    info "Collecting garbage..."
    nh clean all --keep 8
    success "Garbage collection complete!"
    ;;
  fmt)
    info "Formatting Nix files..."
    nix fmt
    success "Format complete!"
    ;;
  generations)
    sudo nix-env --list-generations --profile /nix/var/nix/profiles/system | head -50
    ;;
  search) nix search nixpkgs "$@" ;;
  run)
    pkg="${1:-}"
    if [ -z "$pkg" ]; then error "Please specify a package to run. Usage: nyx run <pkg>"; fi
    shift
    if [[ "$pkg" == *#* ]] || [[ "$pkg" == *:* ]] || [[ "$pkg" == .* ]]; then
      exec nix run "$pkg" -- "$@"
    else
      exec nix run "nixpkgs#$pkg" -- "$@"
    fi
    ;;
  shell)
    pkgs=()
    while [ $# -gt 0 ]; do
      pkg="$1"
      if [[ "$pkg" == *#* ]] || [[ "$pkg" == *:* ]] || [[ "$pkg" == .* ]]; then
        pkgs+=("$pkg")
      else
        pkgs+=("nixpkgs#$pkg")
      fi
      shift
    done
    if [ ${#pkgs[@]} -eq 0 ]; then error "Please specify at least one package. Usage: nyx shell <pkg>..."; fi
    exec nix shell "${pkgs[@]}"
    ;;
  module) cmd_module "$@" ;;
  help) cmd_help ;;
  *) error "Unknown subcommand: $cmd. Run 'nyx help'." ;;
esac
