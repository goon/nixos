animations {

    window-open {
        duration-ms 300
        curve "cubic-bezier" 0.05 0.9 0.1 1.05
    }

    window-close {
        duration-ms 300
        curve "ease-out-expo"
    }

    workspace-switch {
        duration-ms 300
        curve "ease-out-expo"
    }

    window-movement {
        duration-ms 300
        curve "ease-out-expo"
    }
    
    window-resize {
        duration-ms 300
        curve "ease-out-expo"
    }
}
