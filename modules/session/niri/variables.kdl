workspace "static"

prefer-no-csd

environment {
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_DESKTOP "niri"
}

hotkey-overlay {
    skip-at-startup
    hide-not-bound
}

screenshot-path "~/Pictures/Screenshots/%Y-%m-%d %H-%M-%S.png"

input {
    keyboard {
        repeat-delay 200
        repeat-rate 35
        xkb {
            layout "gb"
        }
        numlock
    }

    mouse {
        accel-profile "flat"
        accel-speed 0.0
    }

    focus-follows-mouse max-scroll-amount="0%"
}

gestures {
    hot-corners {
        off
    }
}

cursor {
    xcursor-theme "Bibata-Modern-Ice"
    xcursor-size 28
}

output "DP-3" {
    mode custom=true "3440x1440@144.000"
    position x=0 y=0
}
