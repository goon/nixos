#!/usr/bin/env bash

# Restart Quickshell script
# Improved version of the rqs alias

APP="quickshell"

# Function to send notifications
notify() {
    if command -v notify-send >/dev/null; then
        notify-send "Quickshell" "$1" \
            --app-name="Quickshell" \
            --icon="system-software-update" \
            --urgency=low
    fi
}

echo "Stopping Quickshell..."

# Kill all existing instances
pkill "quickshell"

# Wait for them to actually exit
COUNT=0
while pgrep "quickshell" >/dev/null && [ $COUNT -lt 20 ]; do
    sleep 0.1
    ((COUNT++))
done

# If still running, force kill
if pgrep "quickshell" >/dev/null; then
    echo "Forcing exit..."
    pkill -9 "quickshell"
fi

# Start new instance in background
# Use nohup and redirection to ensure it doesn't clutter terminal or die on exit
nohup "$APP" >/dev/null 2>&1 &

if [ $? -eq 0 ]; then
    notify "Shell restarted successfully"
    echo "Done."
else
    notify "Failed to restart Shell"
    echo "Error: Failed to start $APP"
    exit 1
fi
